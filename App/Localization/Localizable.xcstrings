      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the group centered together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일행을 화면 가운데로 모아보세요."
          }
        }
      }
    },
    "reason.headroom_loose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a bit too much space above."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 위 여백이 조금 많아요."
          }
        }
      }
    },
    "reason.headroom_tight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave a little room above the head."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 위 여백을 조금 더 주세요."
          }
        }
      }
    },
    "reason.horizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tilted horizon feels unsteady."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울어진 수평선은 불안해 보여요."
          }
        }
      }
    },
    "reason.looking_room": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave space in the direction they're facing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시선 방향에 여백을 만들어보세요."
          }
        }
      }
    },
    "reason.negative_space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it some breathing room."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 여백을 조금 정리해보세요."
          }
        }
      }
    },
    "reason.symmetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center it to bring out the symmetry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대칭이 살아나도록 중앙에 맞춰보세요."
